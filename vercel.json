{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "web/build.sh",
  "outputDirectory": "web",
  "functions": {
    "api/scan.mjs": { "maxDuration": 30 }
  },
  "headers": [
    {
      "source": "/feeddoctor.wasm",
      "headers": [
        { "key": "Content-Type", "value": "application/wasm" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
