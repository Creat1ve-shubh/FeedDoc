# Copy to .env and fill in from the app's page in the Shopify Partner Dashboard.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_legal_policies
# Public https URL Shopify can reach, e.g. a cloudflared or ngrok tunnel to :8080.
# On Render this can be left out: the server uses RENDER_EXTERNAL_URL.
APP_URL=https://your-tunnel.example.com
DATABASE_URL=postgres://feeddoctor:feeddoctor@localhost:5433/feeddoctor
# Optional. Without it the rescan queue lives in memory (fine for local testing).
REDIS_URL=redis://localhost:6379/0
PORT=8080
SCAN_WORKERS=4
